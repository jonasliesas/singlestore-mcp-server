{
  "name": "singlestore-mcp-codemirror-bundle",
  "private": true,
  "description": "Builds the CodeMirror bundle inlined into the SQL Editor app (src/singlestore_mcp/apps/vendor/codemirror-bundle.js).",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=iife --global-name=CM --minify --legal-comments=eof --target=es2020 --outfile=../../src/singlestore_mcp/apps/vendor/codemirror-bundle.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.2.0",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
