# Copy to .env for local testing with `uv run` / `python-dotenv`, or copy
# these into the "env" block of .vscode/mcp.json instead (VS Code does not
# read .env files on its own).

# Option A: individual fields (works for both Helios and self-managed)
SINGLESTORE_HOST=127.0.0.1
SINGLESTORE_PORT=3306
SINGLESTORE_USER=root
SINGLESTORE_PASSWORD=
SINGLESTORE_DATABASE=
# Self-managed clusters without TLS configured need this set to true.
SINGLESTORE_SSL_DISABLED=false

# Option B: single connection string, overrides all of the above if set
# SINGLESTORE_URL=user:password@host:3306/database
